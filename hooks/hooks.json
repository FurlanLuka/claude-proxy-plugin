{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "for f in \"${CLAUDE_PLUGIN_ROOT}\"/references/*.md; do case \"$(basename \"$f\")\" in walkthrough-principles.md) continue;; esac; echo \"=== $f ===\"; cat \"$f\"; echo; done"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/notify-telegram.sh",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
