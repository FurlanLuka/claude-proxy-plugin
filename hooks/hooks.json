{
  "description": "solo: auto-approve ExitPlanMode only while a solo run has armed the session marker; disarm on any prompt outside plan mode.",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/approve-solo-plan.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/clear-solo-marker.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
