{
  "description": "solo: arm the session marker when proxy:solo is invoked (typed slash command or Skill tool); while it exists, auto-approve ExitPlanMode and deny AskUserQuestion. Disarm when proxy:pair or proxy:brainstorm is invoked, or on a prompt that is only \"stop solo\". Other prompts, including steering and subagent reports, leave it armed.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/arm-solo-marker.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/block-solo-question.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/approve-solo-plan.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-solo-marker.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
